# SYRIX Forma — environment variables
# Copy to .env.local for local dev. Never commit the real file (see .gitignore).
# Every variable the app reads must have a name listed here, even before it has a real value.

# --- Environment ---
NODE_ENV=development
APP_ENV=development

# --- Database (Neon Postgres — free tier, see DEPENDENCIES.md) ---
# Use the pooled connection string (host contains "-pooler"); the client is configured for it.
DATABASE_URL=

# --- Auth (Clerk — free Hobby tier, see DEPENDENCIES.md) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- MFA (Phase 1 — Clerk's free tier has no MFA, so TOTP is layered on top; see DEPENDENCIES.md) ---
# 32-byte random key, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# --- App URL (absolute metadata URLs; the Hostinger Mail webhook URL shown on Settings >
# Integrations; and the link in the email an administrator gets when somebody asks for access.
# Required once deployed — the Hub refuses to boot without it, see lib/config/preflight.ts.
# Leave blank for local dev.) ---
NEXT_PUBLIC_APP_URL=

# --- The founding administrator ---
# Every account that signs up waits for an administrator to approve it. That rule has exactly one
# hole and it has to: the first account has nobody to approve it, so an installation with no
# administrator could never get one.
#
# This is that hole, kept as small as possible. It is NOT "whoever signs in first" — on a public
# URL that is a stranger, and it would hand them the account that grants everyone else their role.
# It is one named address, and it only applies while the installation has no employees at all.
# Once an administrator exists, no email bypasses approval, including this one.
OWNER_EMAIL=

# --- Deployment (Cloudflare Tunnel — see DEPLOY.md) ---
# Connector token for the named tunnel, from the Cloudflare Zero Trust dashboard. It lets a
# cloudflared container serve the hostnames that tunnel is configured for and nothing else; it is
# not a Cloudflare API key and cannot change DNS or the account. Only needed on the machine
# actually running the deployment — leave blank everywhere else.
CLOUDFLARE_TUNNEL_TOKEN=

# --- SYRIX AI's sandboxed browser ---
# Off unless set. playwright-core drives an installed Chromium and does not ship one, so this is
# only turned on where a browser actually exists. With it off, research still works — the browser
# lane is skipped rather than throwing (lib/ai/research/browser.ts).
FORMA_AI_BROWSER=

# --- Error tracking (Sentry — optional, ships with the starter; see DEPENDENCIES.md) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DISABLED="true"

# --- Redis / Queue (Upstash — free tier, see DEPENDENCIES.md) ---
REDIS_URL=

# --- Integrations (Phase 4) ---
# Hostinger Mail: no env var here — the API token, mailbox resource ID, and webhook bearer token
# are entered live by an ADMIN on Settings > Integrations and stored encrypted in the database
# (see DEPENDENCIES.md), not as plaintext environment variables. Override only if Hostinger's API
# host ever changes:
HOSTINGER_MAIL_API_BASE_URL=

# Microsoft 365 / SharePoint / OneDrive / NAS: no credentials at all — this integration is
# reference-only document links plus a periodic reachability check, not a Graph API connection
# (see docs/data-model.md's DocumentLink entity).

# Google Calendar: not yet built (deferred) — kept here as a placeholder for when that work
# starts, per the build plan Phase 4.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Email (Resend — free tier, see DEPENDENCIES.md) ---
RESEND_API_KEY=
# Use the sandbox address (onboarding@resend.dev) for local dev unless a domain is verified.
NOTIFICATIONS_FROM_EMAIL=

# --- SYRIX AI (Phase 7) ---
# The Hub holds NO provider key. Model access goes through a Cloudflare Worker the
# operator owns, which holds every provider key as a Worker secret and does the
# failover between free tiers on its own side. The Hub holds only a revocable
# device token, obtained by pairing:
#
#   npx tsx scripts/pair-gateway.ts --from-config
#
# See docs/forma-ai-architecture.md §2.
FORMA_AI_GATEWAY_URL=
FORMA_AI_GATEWAY_TOKEN=
FORMA_AI_GATEWAY_DEVICE=

# Direct provider keys — LOCAL DEVELOPMENT ONLY, and a fallback if the gateway is
# unreachable. In a shipped deployment these stay blank and the chain is one link
# long. Each is free and needs no card; each one set is more headroom, because a
# request walks the chain until a provider answers.
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Optional per-provider model overrides. Defaults live in lib/ai/gateway/providers.ts;
# model names date fast, so override here rather than editing code.
GROQ_SPARK_MODEL=
GROQ_ZENITH_MODEL=
CEREBRAS_SPARK_MODEL=
CEREBRAS_ZENITH_MODEL=
MISTRAL_SPARK_MODEL=
MISTRAL_ZENITH_MODEL=
OPENROUTER_SPARK_MODEL=
OPENROUTER_ZENITH_MODEL=

# --- Team Chat file storage (Cloudflare R2 — free tier, see DEPENDENCIES.md) ---
# Leave all four blank in local dev and the app falls back to a gitignored local folder
# (lib/storage/local-dev.ts) — never reachable once NODE_ENV isn't literally 'development'.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Access-code mode (a demonstration deployment, not a way to run the Hub) ---
# Replaces individual sign-in with one shared code that opens one fixed, already-approved
# account. It exists so the Hub can be shown over the internet before it has a Clerk production
# instance, which needs CNAME records on a domain the operator controls.
#
# What it gives up, in full: there is no "who did this" — every session is the same employee, so
# the audit log and everything recording an author name that person whoever is at the keyboard;
# a code several people know cannot be revoked from one of them; and anyone holding it holds
# whatever that account holds, including administration. Read lib/auth/access-code.ts before
# turning it on.
#
# Set to exactly 'on' to enable. No other value counts, and there is no default.
ACCESS_CODE_MODE=
# Digits only, 4 to 12 of them.
ACCESS_CODE=
# The email of an employees row that already exists and is already active. Nothing in this mode
# creates or promotes an account.
ACCESS_CODE_IDENTITY=
# Optional. How long one unlocked session lasts (default 720 minutes), how many wrong answers are
# allowed before a lockout (default 5) and how long that lockout lasts (default 5 minutes).
ACCESS_CODE_SESSION_MINUTES=
ACCESS_CODE_MAX_ATTEMPTS=
ACCESS_CODE_LOCKOUT_MINUTES=
#
# In this mode RESEND_API_KEY and NOTIFICATIONS_FROM_EMAIL must be blank, and the Hub refuses to
# start if either is set: a deployment being shown to people is deliberately unable to send mail
# or to reach any connected third-party account. REDIS_URL is required, because a lockout held
# only in memory starts again every time a sleeping instance wakes.

# --- Build output directory ---
# Which folder `next build` and `next dev` write to. Leave blank for the default (.next). A
# deployment build run from the same checkout as a running dev server must set this to something
# else: both default to .next, and the build overwrites the chunks the dev server is still
# serving, which presents as pages losing their styling or existing routes returning 404.
NEXT_DIST_DIR=
